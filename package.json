{
  "name": "poromy-front",
  "version": "0.1.0",
  "private": true,
  "sideEffects": [
    "*.css",
    "*.scss",
    "*.sass",
    "./src/app/globals.css",
    "./public/sw.js"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "pnpm cursorrules:update && next build",
    "build:analyze": "ANALYZE=true pnpm build",
    "start": "next start",
    "lint": "next lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "generate-icons": "svgr --config-file .svgrrc.mjs --out-dir src/assets/icons -- public/svg/*.svg",
    "generate-company-data": "node scripts/generate-data.js",
    "cursorrules:update": "node scripts/update-cursorrules.js",
    "cursorrules:watch": "node scripts/update-cursorrules.js --watch",
    "cursorrules:setup": "node scripts/update-cursorrules.js --hook",
    "dev:auto": "pnpm cursorrules:update && next dev",
    "predev": "pnpm cursorrules:update",
    "postinstall": "pnpm cursorrules:update",
    "migrate-jobs": "node scripts/migrate-jobs-to-supabase.js",
    "migrate-job": "node scripts/migrate-jobs-to-supabase.js --single"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.1.0",
    "@next/third-parties": "^15.3.2",
    "@supabase/ssr": "^0.6.1",
    "@supabase/supabase-js": "^2.49.4",
    "@tanstack/react-query": "^5.83.0",
    "feed": "^5.0.0",
    "lucide-react": "^0.506.0",
    "next": "15.2.4",
    "nuq": "^0.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.57.0",
    "react-responsive": "^10.0.1",
    "zod": "^3.25.56"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@next/bundle-analyzer": "^15.3.3",
    "@react-email/components": "^0.0.36",
    "@react-email/render": "^1.0.6",
    "@svgr/cli": "^8.1.0",
    "@svgr/webpack": "^8.1.0",
    "@tailwindcss/postcss": "^4",
    "@tanstack/react-query-devtools": "^5.83.0",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@types/react-responsive": "^9.0.0",
    "autoprefixer": "^10.0.1",
    "chokidar": "^3.6.0",
    "dotenv": "^16.5.0",
    "embla-carousel-fade": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "eslint": "^8",
    "eslint-config-next": "15.2.4",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.2.6",
    "eslint-plugin-tailwindcss": "^3.18.0",
    "link-preview-js": "^3.0.14",
    "next-sitemap": "^4.2.3",
    "postcss": "^8",
    "prettier": "^3.5.3",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "raw-loader": "^4.0.2",
    "react-email": "^4.0.7",
    "resend": "^4.4.0",
    "tailwindcss": "^4.1.3",
    "tsx": "^4.19.4",
    "typescript": "^5",
    "webpack-bundle-analyzer": "^4.10.2"
  }
}
